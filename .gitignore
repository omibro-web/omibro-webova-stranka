.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Confidential client material — deliberately NOT versioned.
#
# These documents describe the commercial context behind this site, including
# the relationship to the sister project. The site itself is built so that
# suppliers reviewing the company do not encounter that context; committing
# these would put it in git history permanently, where deleting the file later
# does not remove it. Keep them in local/shared storage instead.
# ---------------------------------------------------------------------------
omibro-web-brief.md
STYLEGUIDE.md
styleguide.html
*.pdf
*.docx

# local tooling
/.gen-*.mjs
